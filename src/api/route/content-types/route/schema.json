{
  "kind": "collectionType",
  "collectionName": "routes",
  "info": {
    "singularName": "route",
    "pluralName": "routes",
    "displayName": "Route",
    "description": "Defines the available routes/paths for the Next.js frontend."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "path": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "label": {
      "type": "customField",
      "customField": "plugin::superfields.tooltip-field",
      "options": {
        "tooltip-content": "Nombre visible de la ruta en el menú de navegación. Ej: 'Inicio', 'Acerca de', 'Carreras'",
        "description": "Etiqueta del menú"
      }
    },
    "type": {
      "type": "customField",
      "customField": "plugin::superfields.tooltip-enum-field",
      "options": {
        "tooltip-content": "Tipo de ruta. 'page': página con contenido · 'section': agrupa sub-rutas sin página propia · 'header': ítem del encabezado de navegación",
        "description": "Tipo de ruta",
        "enumValues": "page\nsection\nheader",
        "required": true
      }
    },
    "order": {
      "type": "customField",
      "customField": "plugin::superfields.tooltip-number-field",
      "options": {
        "tooltip-content": "Posición de esta ruta en el menú. Números menores aparecen primero. Ej: 1 = primer ítem, 2 = segundo",
        "description": "Orden en el menú",
        "default": 0
      }
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "slug": {
      "type": "uid",
      "targetField": "label"
    },
    "parent": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::route.route",
      "inversedBy": "children"
    },
    "children": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::route.route",
      "mappedBy": "parent"
    },
    "page": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::page.page",
      "mappedBy": "route"
    },
    "visibility": {
      "type": "enumeration",
      "enum": ["public", "requires-login"],
      "default": "public",
      "required": false
    }
  }
}
