{
  "kind": "collectionType",
  "collectionName": "routes",
  "info": {
    "singularName": "route",
    "pluralName": "routes",
    "displayName": "Ruta (menú)",
    "description": "Entradas del menú de navegación: dirección, etiqueta y orden de cada página o sección del sitio."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "path": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "label": {
      "type": "string"
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "page",
        "section",
        "header"
      ],
      "required": true
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "slug": {
      "type": "uid",
      "targetField": "label"
    },
    "parent": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::route.route",
      "inversedBy": "children"
    },
    "children": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::route.route",
      "mappedBy": "parent"
    },
    "page": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::page.page",
      "mappedBy": "route"
    },
    "visibility": {
      "type": "enumeration",
      "enum": [
        "public",
        "requires-login"
      ],
      "default": "public",
      "required": false
    }
  }
}
