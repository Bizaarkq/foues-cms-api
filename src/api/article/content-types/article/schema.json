{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Article"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": false
    }
  },
  "attributes": {
    "Title": {
      "type": "customField",
      "customField": "plugin::superfields.tooltip-field",
      "options": {
        "tooltip-content": "Título del artículo o noticia. Aparece como encabezado principal y se usa para generar el slug automáticamente",
        "description": "Título del artículo",
        "required": true
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "Title",
      "required": true
    },
    "excerpt": {
      "type": "customField",
      "customField": "plugin::superfields.tooltip-field",
      "options": {
        "tooltip-content": "Resumen breve del artículo. Se muestra en las tarjetas de listado y en el preview. Máximo 2-3 oraciones",
        "description": "Resumen breve (para listados)"
      }
    },
    "content": {
      "type": "richtext"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"]
    }
  }
}
