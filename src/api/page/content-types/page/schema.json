{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Page",
    "description": "Contenido estructural de una ruta."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "customField",
      "customField": "plugin::superfields.tooltip-field",
      "options": {
        "tooltip-content": "Nombre interno de la página. Se usa como referencia en el admin y como título SEO si no hay otro configurado",
        "description": "Nombre de la página",
        "required": true
      }
    },
    "layout": {
      "type": "customField",
      "customField": "plugin::superfields.tooltip-enum-field",
      "options": {
        "tooltip-content": "Diseño de la página. 'default': ancho contenido estándar con márgenes · 'full-width': ocupa todo el ancho de la pantalla",
        "description": "Diseño de la página",
        "enumValues": "default\nfull-width",
        "required": true
      }
    },
    "content": {
      "type": "dynamiczone",
      "components": [
        "blocks.hero-landing",
        "blocks.hero-page",
        "blocks.content-grid",
        "blocks.photo-gallery",
        "blocks.quick-links",
        "blocks.timeline",
        "blocks.mission-vision",
        "blocks.process-steps",
        "blocks.rich-text",
        "blocks.cta",
        "blocks.calendar",
        "blocks.map",
        "blocks.staff-section",
        "blocks.bullet-list",
        "blocks.key-dates",
        "blocks.info-card",
        "blocks.clinic-schedule",
        "blocks.icon-strip",
        "blocks.map-schedule",
        "blocks.section",
        "blocks.form"
      ]
    },
    "route": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::route.route",
      "inversedBy": "page"
    }
  }
}
