{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Página",
    "description": "Página del sitio: título, diseño y bloques de contenido."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "layout": {
      "type": "enumeration",
      "enum": [
        "default",
        "full-width"
      ],
      "required": true
    },
    "content": {
      "type": "dynamiczone",
      "components": [
        "blocks.hero-landing",
        "blocks.hero-page",
        "blocks.article-list",
        "blocks.photo-gallery",
        "blocks.quick-links",
        "blocks.timeline",
        "blocks.mission-vision",
        "blocks.process-steps",
        "blocks.rich-text",
        "blocks.cta",
        "blocks.calendar",
        "blocks.map",
        "blocks.staff-section",
        "blocks.bullet-list",
        "blocks.key-dates",
        "blocks.info-card",
        "blocks.clinic-schedule",
        "blocks.icon-strip",
        "blocks.map-schedule",
        "blocks.section",
        "blocks.form",
        "blocks.magazine-archive",
        "blocks.accordion",
        "blocks.tabs",
        "blocks.carousel",
        "blocks.table"
      ]
    },
    "route": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::route.route",
      "inversedBy": "page"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
