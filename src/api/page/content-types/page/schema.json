{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Page",
    "description": "Contenido estructural de una ruta."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "layout": {
      "type": "enumeration",
      "enum": [
        "default",
        "full-width"
      ],
      "default": "default",
      "required": true
    },
    "content": {
      "type": "dynamiczone",
      "components": [
        "blocks.hero-landing",
        "blocks.hero-page",
        "blocks.content-grid",
        "blocks.photo-gallery",
        "blocks.quick-links",
        "blocks.timeline",
        "blocks.mission-vision",
        "blocks.process-steps",
        "blocks.rich-text",
        "blocks.cta",
        "blocks.calendar",
        "blocks.map"
      ]
    },
    "route": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::route.route",
      "inversedBy": "page"
    }
  }
}
