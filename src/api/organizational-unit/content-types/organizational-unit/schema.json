{
  "kind": "collectionType",
  "collectionName": "organizational_units",
  "info": {
    "singularName": "organizational-unit",
    "pluralName": "organizational-units",
    "displayName": "Unidad Organizacional",
    "description": "Comités, decanato, junta directiva y unidades administrativas"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "nombre": {
      "type": "string",
      "required": true
    },
    "tipo": {
      "type": "enumeration",
      "enum": [
        "decanato",
        "vicedecanato",
        "junta_directiva",
        "comite_tecnico",
        "unidad_administrativa"
      ],
      "required": true
    },
    "descripcion": {
      "type": "string"
    },
    "miembros": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::staff.staff",
      "inversedBy": "unidades"
    }
  }
}
