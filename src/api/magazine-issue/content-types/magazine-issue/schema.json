{
  "kind": "collectionType",
  "collectionName": "magazine_issues",
  "info": {
    "singularName": "magazine-issue",
    "pluralName": "magazine-issues",
    "displayName": "Edición de revista",
    "description": "Ediciones en PDF: subí el archivo y el sistema genera las páginas para el visor."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "number": {
      "type": "integer"
    },
    "date": {
      "type": "date"
    },
    "description": {
      "type": "text"
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "pdf": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "files"
      ]
    },
    "pages": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "conversionStatus": {
      "type": "enumeration",
      "enum": [
        "processing",
        "ready",
        "failed"
      ]
    },
    "publication": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::publication.publication",
      "inversedBy": "issues",
      "required": true
    }
  }
}
