{
  "kind": "collectionType",
  "collectionName": "forms",
  "info": {
    "singularName": "form",
    "pluralName": "forms",
    "displayName": "Formulario",
    "description": "Formularios del sitio: definí los campos y consultá los envíos desde esta pantalla."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "submit_label": {
      "type": "string",
      "default": "Enviar"
    },
    "success_message": {
      "type": "text",
      "default": "Gracias por tu envío."
    },
    "error_message": {
      "type": "text"
    },
    "fields": {
      "type": "component",
      "repeatable": true,
      "component": "elements.form-field"
    },
    "email_to": {
      "type": "string"
    }
  }
}
