{
  "kind": "collectionType",
  "collectionName": "staffs",
  "info": {
    "singularName": "staff",
    "pluralName": "staffs",
    "displayName": "Personal",
    "description": "Miembros del personal de la facultad: docentes, autoridades y administrativos."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "nombre": {
      "type": "string",
      "required": true
    },
    "cargo": {
      "type": "string",
      "required": true
    },
    "foto": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "descripcion": {
      "type": "string"
    },
    "contacto": {
      "type": "component",
      "repeatable": false,
      "component": "staff.contacto"
    },
    "cv": {
      "type": "component",
      "repeatable": true,
      "component": "staff.cv-item"
    },
    "unidades": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::organizational-unit.organizational-unit",
      "mappedBy": "miembros"
    }
  }
}
