{
  "collectionName": "components_staff_cv_items",
  "info": {
    "displayName": "CV Item",
    "description": "Entrada de formación académica o experiencia profesional"
  },
  "options": {},
  "attributes": {
    "tipo": {
      "type": "customField",
      "customField": "plugin::superfields.tooltip-enum-field",
      "options": {
        "tooltip-content": "Categoría del ítem del CV. 'academico': títulos, posgrados, cursos · 'profesional': cargos, experiencia laboral",
        "description": "Tipo de entrada del CV",
        "enumValues": "academico\nprofesional",
        "required": true
      }
    },
    "titulo": {
      "type": "customField",
      "customField": "plugin::superfields.tooltip-field",
      "options": {
        "tooltip-content": "Nombre del título, cargo o logro. Ej: 'Doctor en Odontología', 'Jefe de Trabajos Prácticos'",
        "description": "Título o nombre del cargo",
        "required": true
      }
    },
    "institucion": {
      "type": "customField",
      "customField": "plugin::superfields.tooltip-field",
      "options": {
        "tooltip-content": "Institución donde se obtuvo el título o donde se desempeñó el cargo. Ej: 'UBA', 'Hospital Alemán'",
        "description": "Institución",
        "required": true
      }
    },
    "fecha_inicio": {
      "type": "date",
      "required": true
    },
    "fecha_fin": {
      "type": "date"
    }
  }
}
