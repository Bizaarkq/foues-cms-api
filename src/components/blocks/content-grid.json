{
  "collectionName": "components_blocks_content_grids",
  "info": {
    "displayName": "Content Grid",
    "description": "Grid of elements like cards natively inside the page"
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "collection_type": {
      "type": "enumeration",
      "enum": ["news", "events", "programs", "faculty"],
      "required": false
    },
    "card_style": {
      "type": "enumeration",
      "enum": ["default", "compact", "featured", "horizontal"],
      "default": "default"
    },
    "columns": {
      "type": "enumeration",
      "enum": ["col_1", "col_2", "col_3", "col_4"],
      "default": "col_3"
    },
    "items": {
      "type": "component",
      "repeatable": true,
      "component": "elements.card"
    }
  }
}
