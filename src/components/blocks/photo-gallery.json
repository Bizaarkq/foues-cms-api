{
  "collectionName": "components_blocks_photo_galleries",
  "info": {
    "displayName": "Photo Gallery",
    "description": "Grid or masonry layout of images"
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "customField",
      "customField": "plugin::superfields.tooltip-field",
      "options": {
        "tooltip-content": "Título de la galería. Se muestra encima de las fotos",
        "description": "Título de la galería"
      }
    },
    "subtitle": {
      "type": "customField",
      "customField": "plugin::superfields.tooltip-field",
      "options": {
        "tooltip-content": "Descripción breve de la galería. Se muestra debajo del título",
        "description": "Descripción (opcional)"
      }
    },
    "images": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": ["images"]
    },
    "photo_columns": {
      "type": "customField",
      "customField": "plugin::superfields.tooltip-enum-field",
      "options": {
        "tooltip-content": "Cantidad de columnas para mostrar las fotos. 'col_2': 2 columnas · 'col_3': 3 (recomendado) · 'col_4': 4",
        "description": "Columnas de la galería",
        "enumValues": "col_2\ncol_3\ncol_4",
        "default": "col_3"
      }
    }
  }
}
