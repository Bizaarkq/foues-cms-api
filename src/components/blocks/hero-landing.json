{
  "collectionName": "components_blocks_hero_landings",
  "info": {
    "displayName": "Hero Landing",
    "description": "Full-page hero for landing/home pages with prominent CTA buttons"
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "customField",
      "customField": "plugin::superfields.tooltip-field",
      "options": {
        "tooltip-content": "Título principal que aparece grande en el centro del hero. Es lo primero que ve el visitante",
        "description": "Título principal"
      }
    },
    "subtitle": {
      "type": "customField",
      "customField": "plugin::superfields.tooltip-field",
      "options": {
        "tooltip-content": "Texto secundario debajo del título. Puede ser un slogan o descripción breve de la página",
        "description": "Subtítulo o descripción breve"
      }
    },
    "backgroundImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "buttons": {
      "type": "component",
      "repeatable": true,
      "component": "elements.button"
    }
  }
}
