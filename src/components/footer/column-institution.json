{
  "collectionName": "components_footer_column_institutions",
  "info": {
    "displayName": "Footer Column Institution",
    "description": "Logo, institution name, description and social links"
  },
  "options": {},
  "attributes": {
    "logo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "institution_name": {
      "type": "customField",
      "customField": "plugin::superfields.tooltip-field",
      "options": {
        "tooltip-content": "Nombre completo de la institución tal como aparece en el footer. Ej: 'Facultad de Odontología'",
        "description": "Nombre de la institución"
      }
    },
    "sub_name": {
      "type": "customField",
      "customField": "plugin::superfields.tooltip-field",
      "options": {
        "tooltip-content": "Nombre secundario o pertenencia institucional. Ej: 'Universidad de Buenos Aires'",
        "description": "Nombre secundario (universidad, etc.)"
      }
    },
    "description": {
      "type": "customField",
      "customField": "plugin::superfields.tooltip-field",
      "options": {
        "tooltip-content": "Breve descripción institucional que aparece debajo del nombre en el footer",
        "description": "Descripción institucional breve"
      }
    },
    "social_links": {
      "type": "component",
      "repeatable": true,
      "component": "elements.button"
    }
  }
}
