{
  "collectionName": "components_elements_cards",
  "info": {
    "displayName": "Card",
    "description": "Card with image, title, and link"
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "customField",
      "customField": "plugin::superfields.tooltip-field",
      "options": {
        "tooltip-content": "Título de la tarjeta. Aparece como encabezado principal de la card",
        "description": "Título de la tarjeta",
        "required": true
      }
    },
    "description": {
      "type": "customField",
      "customField": "plugin::superfields.tooltip-field",
      "options": {
        "tooltip-content": "Texto descriptivo que aparece debajo del título de la tarjeta",
        "description": "Descripción (opcional)"
      }
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "url": {
      "type": "customField",
      "customField": "plugin::superfields.tooltip-field",
      "options": {
        "tooltip-content": "Enlace al que lleva la tarjeta al hacer clic. Puede ser relativo ('/noticias/1') o absoluto ('https://...')",
        "description": "URL de destino"
      }
    },
    "tag": {
      "type": "customField",
      "customField": "plugin::superfields.tooltip-field",
      "options": {
        "tooltip-content": "Etiqueta opcional que aparece como badge en la tarjeta. Ej: 'Nuevo', 'Destacado', una categoría",
        "description": "Etiqueta / badge (opcional)"
      }
    },
    "customClasses": {
      "type": "customField",
      "customField": "plugin::superfields.tooltip-field",
      "options": {
        "tooltip-content": "Clases CSS adicionales para personalizar el estilo de la tarjeta. Solo para uso técnico — dejá vacío si no sabés qué es esto",
        "description": "Clases CSS personalizadas (solo técnico)"
      }
    }
  }
}
