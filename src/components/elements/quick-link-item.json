{
  "collectionName": "components_elements_quick_link_items",
  "info": {
    "displayName": "Quick Link Item",
    "description": "Card item for Quick Links block with icon, title and description"
  },
  "options": {},
  "attributes": {
    "label": {
      "type": "customField",
      "customField": "plugin::superfields.tooltip-field",
      "options": {
        "tooltip-content": "Texto del acceso rápido. Debe ser breve y descriptivo. Ej: 'Inscripción', 'Mesa de ayuda', 'Plan de estudios'",
        "description": "Texto del enlace",
        "required": true
      }
    },
    "url": {
      "type": "customField",
      "customField": "plugin::superfields.tooltip-field",
      "options": {
        "tooltip-content": "Destino del enlace al hacer clic. Puede ser relativo ('/inscripcion') o absoluto ('https://...')",
        "description": "URL de destino"
      }
    },
    "icon": {
      "type": "customField",
      "customField": "plugin::strapi-lucide-icons.icon"
    },
    "description": {
      "type": "customField",
      "customField": "plugin::superfields.tooltip-field",
      "options": {
        "tooltip-content": "Texto de apoyo que aparece debajo del label en la tarjeta. Opcional",
        "description": "Descripción breve (opcional)"
      }
    }
  }
}
