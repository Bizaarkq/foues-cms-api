{
  "collectionName": "components_elements_schedule_items",
  "info": {
    "displayName": "Schedule Item",
    "description": "A single entry in an academic calendar or schedule block"
  },
  "options": {},
  "attributes": {
    "date": {
      "type": "date",
      "required": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "category": {
      "type": "enumeration",
      "enum": ["academic", "event", "deadline", "holiday", "other"],
      "default": "academic"
    }
  }
}
