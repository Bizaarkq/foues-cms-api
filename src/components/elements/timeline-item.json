{
  "collectionName": "components_elements_timeline_items",
  "info": {
    "displayName": "Timeline Item",
    "description": "A single event or milestone in a timeline block"
  },
  "options": {},
  "attributes": {
    "year": {
      "type": "customField",
      "customField": "plugin::superfields.tooltip-field",
      "options": {
        "tooltip-content": "Año o fecha del evento en la línea de tiempo. Ej: '1998', '2003–2005'",
        "description": "Año o período",
        "required": true
      }
    },
    "title": {
      "type": "customField",
      "customField": "plugin::superfields.tooltip-field",
      "options": {
        "tooltip-content": "Nombre del hito o evento histórico que se muestra junto al año",
        "description": "Título del evento",
        "required": true
      }
    },
    "description": {
      "type": "customField",
      "customField": "plugin::superfields.tooltip-field",
      "options": {
        "tooltip-content": "Descripción ampliada del evento. Opcional — agregar si el hito necesita más contexto",
        "description": "Descripción (opcional)"
      }
    }
  }
}
